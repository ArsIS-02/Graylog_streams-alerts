[SERVICE]
    Flush            5
    Log_Level        info
    storage.path     /var/lib/fluent-bit/storage

# Читаем journald. Path НЕ задаём: с явным путём fluent-bit теряет журнал
# после каждой ротации (застревает на sealed-файле, лаг доставки 10+ минут).
# Без Path sd_journal_open читает дефолтные каталоги и сам следит за ротацией.
# Подробности: docs/35-fluent-bit-journald-path.md
[INPUT]
    Name             systemd
    Tag              journal.*
    # Path           /var/log/journal
    DB               /var/lib/fluent-bit/journal.db
    Read_From_Tail   On
    Strip_Underscores On

# Оставляем только записи контейнеров (у них есть поле CONTAINER_NAME из драйвера journald Podman)
[FILTER]
    Name             grep
    Match            journal.*
    Regex            CONTAINER_NAME .+

# Выкидываем пустые сообщения — без них индекс чище
[FILTER]
    Name             grep
    Match            journal.*
    Exclude          MESSAGE ^\s*$

# Journald иногда подбрасывает поля с пустым именем, GELF-вход Graylog их не
# переваривает. Lua-фильтр удаляет такие ключи (скрипт — clean.lua из этого каталога)
[FILTER]
    Name             lua
    Match            journal.*
    script           /var/lib/fluent-bit/clean.lua
    call             drop_empty_keys

# Отправка в Graylog по GELF TCP. Замени <graylog> на адрес сервера Graylog.
# Порт 12202 — input "GELF TCP", отдельный от GELF UDP (12201).
[OUTPUT]
    Name                     gelf
    Match                    journal.*
    Host                     <graylog>
    Port                     12202
    Mode                     tcp
    Gelf_Short_Message_Key   MESSAGE
    Gelf_Host_Key            HOSTNAME
    Gelf_Level_Key           PRIORITY
