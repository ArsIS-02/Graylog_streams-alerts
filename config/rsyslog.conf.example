# Фрагмент rsyslog для отправки логов на сервер Graylog.
# Добавьте в конец /etc/rsyslog.conf и перезапустите:
#   sudo systemctl restart rsyslog.service
#
# UDP (быстро, возможны потери) — порт 1514:
# *.* @<IP-адрес-сервера>:1514
#
# TCP (надёжная доставка) — используйте @@ и соответствующий вход Graylog:
# *.* @@<IP-адрес-сервера>:1514

# Пример отправки всех событий по UDP на сервер Graylog:
*.* @192.168.1.210:1514
