[
  {
    "title": "Контейнеры: всплеск ошибок",
    "description": "Больше 10 реальных ошибок за 5 минут в одном контейнере: loglevel error/warn/fatal (loki/promtail) или ключевые слова error/fatal/panic/exception/traceback в message. Исключены cadvisor, fluent-bit и promtail (штатный инфраструктурный шум).",
    "priority": 2,
    "alert": true,
    "config": {
      "type": "aggregation-v1",
      "query": "(loglevel:(error OR warn OR fatal) OR message:(error OR fatal OR panic OR exception OR traceback)) AND _exists_:container_name AND NOT container_name:(cadvisor OR fluent-bit OR promtail)",
      "query_parameters": [],
      "filters": [],
      "streams": [
        "<CONTAINERS_STREAM_ID>"
      ],
      "stream_categories": [],
      "group_by": [
        "container_name"
      ],
      "series": [
        {
          "type": "count",
          "id": "count-000",
          "field": null
        }
      ],
      "conditions": {
        "expression": {
          "expr": ">",
          "left": {
            "expr": "number-ref",
            "ref": "count-000"
          },
          "right": {
            "expr": "number",
            "value": 10
          }
        }
      },
      "search_within_ms": 300000,
      "execute_every_ms": 60000,
      "use_cron_scheduling": false,
