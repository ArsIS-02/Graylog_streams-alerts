// description: Добавляет src_zone (сеть адреса источника входа) по CIDR-таблице homelab-subnets.
rule "homelab: windows src_zone"
when
  has_field("winlogbeat_winlog_event_data_IpAddress")
  AND lookup_has_value("homelab-subnets", to_string($message.winlogbeat_winlog_event_data_IpAddress))
then
  set_field("src_zone", lookup_value("homelab-subnets", to_string($message.winlogbeat_winlog_event_data_IpAddress)));
end
