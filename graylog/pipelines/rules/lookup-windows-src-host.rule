// description: Добавляет src_host по IpAddress (адрес источника входа) из Lookup Table homelab-ip-names.
rule "homelab: windows src_host"
when
  has_field("winlogbeat_winlog_event_data_IpAddress")
  AND lookup_has_value("homelab-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress))
then
  set_field("src_host", lookup_value("homelab-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress)));
end
