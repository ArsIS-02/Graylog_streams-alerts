// description: Сверяет адрес источника входа в Windows (IpAddress из событий Security) с базой IOC TrafficLens (lookup table trafficlens-iocs). При совпадении ставит tl_ioc_hit, tl_ioc_ip и tl_ioc_info (глава 20).
rule "trafficlens: ioc windows src IP"
when
  has_field("winlogbeat_winlog_event_data_IpAddress")
  AND lookup_has_value("trafficlens-iocs", to_string($message.winlogbeat_winlog_event_data_IpAddress))
then
  set_field("tl_ioc_hit", true);
  set_field("tl_ioc_ip", to_string($message.winlogbeat_winlog_event_data_IpAddress));
  set_field("tl_ioc_info", lookup_value("trafficlens-iocs", to_string($message.winlogbeat_winlog_event_data_IpAddress)));
end
