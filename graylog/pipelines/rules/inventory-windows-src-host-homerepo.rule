// description: Если ни homelab-ip-names, ни HostDeck не знают адрес источника входа в Windows, добавляет src_host из инвентаря HomeRepo (Lookup Table homerepo-ip-names, глава 21).
rule "inventory: windows src_host from HomeRepo"
when
  has_field("winlogbeat_winlog_event_data_IpAddress")
  AND NOT has_field("src_host")
  AND lookup_has_value("homerepo-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress))
then
  set_field("src_host", lookup_value("homerepo-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress)));
end
