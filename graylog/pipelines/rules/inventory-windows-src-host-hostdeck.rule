// description: Если homelab-ip-names не знает адрес источника входа в Windows, добавляет src_host из инвентаря HostDeck (Lookup Table hostdeck-ip-names, глава 21).
rule "inventory: windows src_host from HostDeck"
when
  has_field("winlogbeat_winlog_event_data_IpAddress")
  AND NOT has_field("src_host")
  AND lookup_has_value("hostdeck-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress))
then
  set_field("src_host", lookup_value("hostdeck-ip-names", to_string($message.winlogbeat_winlog_event_data_IpAddress)));
end
