// description: Добавляет host_profile (профиль HostDeck: server, laptop, lab) по source из Lookup Table hostdeck-host-profile (глава 21).
rule "inventory: host_profile"
when
  has_field("source")
  AND lookup_has_value("hostdeck-host-profile", to_string($message.source))
then
  set_field("host_profile", lookup_value("hostdeck-host-profile", to_string($message.source)));
end
