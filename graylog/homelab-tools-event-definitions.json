[
  {
    "title": "ZASLON - Подбор пароля к панели (5+ неудачных входов за 10 мин)",
    "description": "Пять и более неудачных входов в панель ZaSlon с одного адреса за 10 минут. Своего ограничения частоты входа у панели нет, поэтому подбор замечает Graylog. Адрес клиента — поле zs_client_ip (за прокси — из X-Forwarded-For).\nMITRE ATT&CK. Тактики: Credential Access. Техники: T1110 Brute Force.",
    "priority": 3,
    "alert": true,
    "config": {
      "type": "aggregation-v1",
      "query": "zs_op:login_failed",
      "query_parameters": [],
      "filters": [],
      "streams": [
        "<ZASLON_STREAM_ID>"
      ],
      "stream_categories": [],
      "group_by": [
        "zs_client_ip"
      ],
      "series": [
        {
          "type": "count",
          "id": "count-",
          "field": null
        }
      ],
      "conditions": {
        "expression": {
          "expr": ">=",
          "left": {
            "expr": "number-ref",
            "ref": "count-"
          },
          "right": {
            "expr": "number",
            "value": 5
          }
        }
      },
      "search_within_ms": 600000,
      "execute_every_ms": 60000,
      "use_cron_scheduling": false,
      "cron_expression": null,
      "cron_timezone": null,
      "event_limit": 100
    },
    "field_spec": {
      "host": {
        "data_type": "string",
        "providers": [
          {
            "type": "template-v1",
            "template": "${source.zs_client_ip}",
            "require_values": false,
            "exclude_empty_fields": true
          }
        ]
      },
      "event": {
