      "type": "aggregation-v1",
      "query": "audit_type:SYSCALL AND key:perm_modification AND ((syscall:(53 OR 268) AND a2:/[4-9a-f][0-9a-f]{2}/) OR (syscall:(52 OR 90 OR 91) AND a1:/[4-9a-f][0-9a-f]{2}/)) AND NOT exe:(\"/usr/bin/systemd-tmpfiles\" OR \"/usr/bin/rpm\" OR \"/usr/bin/dnf\" OR \"/usr/bin/dnf5\")",
