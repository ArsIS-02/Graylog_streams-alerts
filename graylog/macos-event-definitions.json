[
  {
    "title": "macOS - Установка или удаление профиля конфигурации",
    "description": "Запуск profiles с install, remove, -I или -R. Профили конфигурации ставят прокси, сертификаты и VPN, отключают защиту. Штатные `profiles list` и `profiles status` не попадают.\nMITRE ATT&CK. Тактики: Defense Impairment. Техники: T1685 Disable or Modify Tools.",
    "priority": 3,
    "alert": true,
    "config": {
      "type": "aggregation-v1",
      "query": "name:es_process_events AND columns_cmdline:/(.*[ \\/])?profiles( .*)? (install|remove|-I|-R)( .*)?/",
      "query_parameters": [],
      "filters": [],
      "streams": [
