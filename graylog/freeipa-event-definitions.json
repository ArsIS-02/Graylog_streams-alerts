[
  {
    "title": "FREEIPA - Изменение пользователей, групп и правил через API",
    "description": "Администратор FreeIPA изменил пользователей, группы, правила HBAC или sudo, роли, пароли или хосты через API. В журнале записаны только такие вызовы, чтения (show, find) не учитываются. Неожиданное изменение означает правку каталога не вами.\nMITRE ATT&CK. Тактики: Persistence. Техники: T1098 Account Manipulation.",
    "priority": 2,
    "alert": true,
    "config": {
      "type": "aggregation-v1",
      "query": "application_name:freeipa_httpd_error AND message:\"ipa: INFO\" AND message:(user_add OR user_del OR user_mod OR user_disable OR group_add OR group_del OR group_mod OR group_add_member OR group_remove_member OR hbacrule_add OR hbacrule_mod OR hbacrule_del OR hbacrule_add_user OR hbacrule_add_host OR sudorule_add OR sudorule_mod OR sudorule_del OR sudorule_add_user OR sudorule_add_option OR passwd OR role_add_member OR privilege_add_member OR cert_revoke OR otptoken_add OR host_add OR host_del OR service_add)",
