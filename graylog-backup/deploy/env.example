# GraylogBackup 0.3. Скопируйте в graylog-backup.env и заполните. Файл не коммитьте (chmod 600).
GRAYLOG_URL=https://graylog.apps.monitoring.test
# Токен API Graylog под отдельной учётной записью с правом только чтения (подходит тот же, что у rule-tester)
GRAYLOG_TOKEN=
# MongoDB Graylog. Если Graylog/Mongo — host-службы на том же хосте, что и контейнер:
GB_MONGO_URI=mongodb://host.containers.internal:27017/graylog
# OpenSearch/Elasticsearch — необязательно: сохраняются только шаблоны индексов, не сами логи
#GB_OPENSEARCH_URL=http://host.containers.internal:9200
# Пароль администратора (обязателен)
GB_PASSWORD=
# Свой центр сертификации (файл смонтирован в контейнер) или GB_INSECURE=1 только для лаборатории
#GB_CA_FILE=/certs/ca.pem
#GB_INSECURE=1
# Ежедневный автозапуск (время по TZ контейнера) и срок хранения архивов
GB_SCHEDULE=03:30
#GB_RETENTION_DAYS=30

# --- Полный бэкап для аварийного восстановления (помимо REST и MongoDB) ---
# server.conf, mongod.conf, opensearch.yml и каталог плагинов лежат на хосте(ах) — контейнеру
# GraylogBackup нужен к ним доступ на чтение. Укажите здесь РЕАЛЬНЫЕ ПУТИ НА ХОСТЕ: install.sh сам
# при установке смонтирует их в контейнер только для чтения и пропишет туда же соответствующие
# GB_SERVER_CONF/GB_MONGOD_CONF/GB_OPENSEARCH_CONF/GB_PLUGIN_DIR — эти четыре переменные трогать
# не нужно, просто оставьте их закомментированными здесь (install.sh читает именно HOST_*, а не
# GB_SERVER_CONF/GB_MONGOD_CONF/GB_OPENSEARCH_CONF/GB_PLUGIN_DIR, из этого файла).
# Без server.conf из копии нельзя будет расшифровать часть значений в MongoDB на новом сервере
# (password_secret) — см. главу 18, раздел «Аварийное восстановление».
#HOST_SERVER_CONF=/etc/graylog/server/server.conf
#HOST_PLUGIN_DIR=/usr/share/graylog-server/plugin
# mongod.conf и opensearch.yml/elasticsearch.yml обычно лежат на ДРУГИХ хостах, чем graylog-server
# (если MongoDB/OpenSearch вынесены отдельно) — контейнер GraylogBackup должен быть на том хосте,
# где лежит нужный файл, либо путь должен быть доступен ему как-то иначе (например, общий том).
#HOST_MONGOD_CONF=/etc/mongod.conf
#HOST_OPENSEARCH_CONF=/etc/opensearch/opensearch.yml
