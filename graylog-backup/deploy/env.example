# GraylogBackup 0.1. Скопируйте в graylog-backup.env и заполните. Файл не коммитьте (chmod 600).
GRAYLOG_URL=https://graylog.apps.monitoring.test
# Токен API Graylog под отдельной учётной записью с правом только чтения (подходит тот же, что у rule-tester)
GRAYLOG_TOKEN=
# MongoDB Graylog. Если Graylog/Mongo — host-службы на том же хосте, что и контейнер:
GB_MONGO_URI=mongodb://host.containers.internal:27017/graylog
# OpenSearch/Elasticsearch — необязательно: сохраняются только шаблоны индексов, не сами логи
#GB_OPENSEARCH_URL=http://host.containers.internal:9200
# Пароль администратора (обязателен)
GB_PASSWORD=
# Свой центр сертификации (файл смонтирован в контейнер) или GB_INSECURE=1 только для лаборатории
#GB_CA_FILE=/certs/ca.pem
#GB_INSECURE=1
# Ежедневный автозапуск (время по TZ контейнера) и срок хранения архивов
GB_SCHEDULE=03:30
#GB_RETENTION_DAYS=30
