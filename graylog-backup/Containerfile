# Сборка из корня репозитория:  podman build -f graylog-backup/Containerfile -t localhost/graylog-backup:latest .
FROM docker.io/library/python:3.12-slim

LABEL org.opencontainers.image.title="GraylogBackup" org.opencontainers.image.version="0.3"

# mongodb-database-tools (mongodump/mongorestore) — официальный архив с бинарниками, не из apt
# (в Debian его нет). Версия и ссылка на changelog ниже: перед сборкой стоит свериться, не вышла
# ли новая — https://www.mongodb.com/docs/database-tools/release-notes/database-tools-changelog/
# Важно: эти бинарники НЕ статические — им нужны libgssapi_krb5.so.2 и другие библиотеки Kerberos/
# LDAP/SSL (их приносит curl как зависимости). Раньше здесь были `apt-get purge -y curl` и
# `apt-get autoremove -y` для экономии места — autoremove вместе с curl выносил и эти библиотеки,
# и mongodump падал в рантайме с «error while loading shared libraries: libgssapi_krb5.so.2:
# cannot open shared object file» (поймано на этой же строке mongodump --version при сборке —
# ради этого она тут и стоит). Поэтому curl и его зависимости теперь остаются в образе: несколько
# лишних мегабайт лучше рабочего mongodump.
ARG MONGO_TOOLS_VERSION=100.20.0
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl; \
    curl -fsSL -o /tmp/mongotools.tgz \
      "https://fastdl.mongodb.org/tools/db/mongodb-database-tools-debian12-x86_64-${MONGO_TOOLS_VERSION}.tgz"; \
    tar -xzf /tmp/mongotools.tgz -C /tmp; \
    cp /tmp/mongodb-database-tools-*/bin/mongodump /tmp/mongodb-database-tools-*/bin/mongorestore /usr/local/bin/; \
    rm -rf /tmp/mongotools.tgz /tmp/mongodb-database-tools-*; \
    rm -rf /var/lib/apt/lists/*; \
    mongodump --version; mongorestore --version

ENV PYTHONUNBUFFERED=1 GB_DATA=/data GB_PORT=8080
RUN useradd -r -u 10002 -d /app gb && mkdir -p /data && chown gb /data
WORKDIR /app/graylog-backup
COPY graylog-backup/backup.py graylog-backup/gl_client.py graylog-backup/version.py graylog-backup/web.py \
     graylog-backup/web_index.html graylog-backup/favicon.svg ./
USER gb
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=5s CMD python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/',timeout=3)"
CMD ["python3", "web.py"]
