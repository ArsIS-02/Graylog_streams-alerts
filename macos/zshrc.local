# ============================================================================
# Кастомный лог команд для Graylog
# ============================================================================
# Зачем: фиксирует каждую команду, введённую в терминале (локально или
# по SSH), в файл ~/.local/log/commands.log. Filebeat читает этот файл
# и отправляет записи в Graylog.
#
# Разворачивается в: ~/.zshrc.local
# Подключается из ~/.zshrc:  source ~/.zshrc.local
#
# ВАЖНО: используем add-zsh-hook preexec, а НЕ preexec() напрямую.
# Прямое определение preexec() затирает все другие хуки (например,
# от oh-my-zsh). Если в конфиге окажутся оба варианта — каждая команда
# будет писаться в лог ДВАЖДЫ, и в Graylog придут дубли.
# ============================================================================

function log_command() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $(whoami) | $(pwd) | $1" >> ~/.local/log/commands.log
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec log_command
