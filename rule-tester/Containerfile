# Сборка из корня репозитория:  podman build -f rule-tester/Containerfile -t localhost/rule-tester:latest .
FROM docker.io/library/python:3.12-slim
LABEL org.opencontainers.image.title="GraylogRuleTester" org.opencontainers.image.version="0.9"
ENV PYTHONUNBUFFERED=1 RT_DATA=/data RT_PORT=8080 TZ=Asia/Yekaterinburg
RUN useradd -r -u 10001 -d /app rt && mkdir -p /data && chown rt /data
WORKDIR /app/rule-tester
COPY rule-tester/lucene.py rule-tester/graylog_api.py rule-tester/rule_tester.py rule-tester/insights.py rule-tester/version.py rule-tester/web.py rule-tester/web_index.html rule-tester/favicon.svg rule-tester/mock_graylog.py rule-tester/art.py rule-tester/methodology.py rule-tester/caldera.py rule-tester/mdlite.py ./
COPY rule-tester/samples/manual.json samples/manual.json
COPY rule-tester/art/plan.json rule-tester/art/NOTICE.md art/
COPY graylog/detections/detections-source.json /app/graylog/detections/detections-source.json
COPY docs/17-admin-guide.md /app/docs/17-admin-guide.md
COPY docs/images/17-*.png /app/docs/images/
COPY detection-tests/tests.json /app/detection-tests/tests.json
COPY detection-tests/windows/Invoke-DetectionTests.ps1 /app/detection-tests/windows/Invoke-DetectionTests.ps1
COPY detection-tests/linux/detection-tests.sh /app/detection-tests/linux/detection-tests.sh
COPY detection-tests/macos/detection-tests.sh /app/detection-tests/macos/detection-tests.sh
COPY detection-tests/freeipa/ipa_detection_tests.py /app/detection-tests/freeipa/ipa_detection_tests.py
COPY detection-tests/containers/detection-tests.sh /app/detection-tests/containers/detection-tests.sh
COPY detection-tests/keenetic/detection-tests.sh /app/detection-tests/keenetic/detection-tests.sh
USER rt
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=5s CMD python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/',timeout=3)"
CMD ["python3", "web.py"]
