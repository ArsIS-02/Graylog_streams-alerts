# GraylogRuleTester 0.1. Скопируйте в rule-tester.env и заполните. Файл не коммитьте (chmod 600).
GRAYLOG_URL=https://graylog.apps.monitoring.test
# Токен API Graylog под отдельной учётной записью с правом только чтения
GRAYLOG_TOKEN=
# Вход GELF HTTP и тестовый поток (создаётся командой setup --apply)
RT_GELF=http://graylog.apps.monitoring.test:12201/gelf
RT_STREAM=Rule Tester
# Пароль администратора (обязателен) и необязательный пароль наблюдателя (только просмотр)
RT_PASSWORD=
#RT_VIEWER_PASSWORD=
# Свой центр сертификации Graylog (файл смонтирован в контейнер) или RT_INSECURE=1 только для лаборатории
#RT_CA_FILE=/certs/ca.pem
#RT_INSECURE=1
# Расписание (время по TZ контейнера): queries@02:30,selftest@03:00,e2e@04:00
RT_SCHEDULE=queries@02:30
# Платформы для ночного e2e (создаёт настоящие алерты). Пусто — e2e по расписанию не запускается
#RT_E2E_PLATFORMS=Windows
